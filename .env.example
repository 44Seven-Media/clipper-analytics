# Copy to .env for local runs (git-ignored). In GitHub, add these under
# Settings → Secrets and variables → Actions instead.
# Leave a platform blank to skip it.

# YouTube Data API v3 key (Google Cloud console)
YOUTUBE_API_KEY=

# Meta (Facebook Pages + Instagram): a System User token from Meta Business Suite
META_ACCESS_TOKEN=

# TikTok developer app (Login Kit + Display API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Encrypts the TikTok tokens saved in data/tokens.enc. Create with: clipper keygen
CLIPPER_TOKEN_KEY=

# X API v2 bearer token (developer.x.com, paid)
X_BEARER_TOKEN=
